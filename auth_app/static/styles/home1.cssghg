* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}


#page1 {
  display: flex;
  /* flex-direction: column; */
  align-items: center;
  justify-content: center;
  color: white;
  text-align: center;
  padding: 0 20px;
  gap: 40px;
}

#page1a {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 10px;
}

#page1a-name {
  color: white;
  font-weight: 700;
  font-size: 20px;
  letter-spacing: 1px;
  padding-right: 6px;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(90deg, #0a192f, #1f3a60, #00b4d8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  /* text-fill-color: transparent; */
  background-size: 400% 400%;
  text-shadow: 2px 2px 8px rgba(124, 58, 237, 0.4);
  animation: gradientFlow 6s ease infinite;
}
#page1a-name  {
    display: flex;
    align-items: center;
    gap: 12px;
}

#page1a-name  img{
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 2px solid black;
    box-shadow: 0 0 10px rgba(128, 0, 128, 0.3); /* Aura glow */
}

@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

#page1a-search {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 520px;
  height: 40px;
  padding: 6px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 7px;
  box-shadow: 0 6px 20px rgba(2, 6, 23, 0.6);
  box-sizing: border-box;
} 

#search {
  flex: 1;
  border: 1px solid rgba(255, 255, 255, 0.02);
  background: transparent;
  color: black;
  font-size: 16px;
  outline: none;
  caret-color: gray;
}

#search-btn {
  border: none;
  border-radius: 10px;
  color: black;
  cursor: pointer;
  font-size: 14px;
  height: 100%;
}

.visually-hidden {
  position: absolute !important;
  height: 1px;
  width: 1px;
  overflow: hidden;
  clip: rect(1px, 1px, 1px, 1px);
  white-space: nowrap;
  border: 0;
  padding: 0;
  margin: -1px;
}


#page1b {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
}

#page2 {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px 20px;
  gap: 40px;
}

#page3 {
  position: relative;
  width: 90%;
  height: 600px;
  margin: 0 auto;
  background-color: #0a192f;
  overflow: hidden;
  background: #222;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

#page3a {
  display: flex;
  height: 50%;
  width: 100%;
  background-size: cover;
  background-position: center;
}

#page3a #slides {
  display: flex;
  transition: transform 1s cubic-bezier(1, 1, 1, 1);
  height: 100%;
  width: 100%;
}

#page3a #slide {
  min-width: 100%;
  position: relative;
  height: 100%;
  background-size: cover;
  background-position: center;
}

#page3a-name {
  color: white;
  font-weight: 700;
  font-size: 70px;
  letter-spacing: 1px;
  padding-right: 6px;
  position: absolute;
  top: 30%;
  left: 7%;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(90deg, #0a192f, #1f3a60, #00b4d8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  /* text-fill-color: transparent; */
  background-size: 400% 400%;
  text-shadow: 2px 2px 8px rgba(124, 58, 237, 0.4);
  animation: gradientFlow 6s ease infinite;
}

#page3b {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 7%;
  padding-top: 30px;
  gap: 20px;
  color: white;
  background-color: rgb(39, 38, 38);
  height: 50%;
  width: 100%;
}

#page3b #head {
  font-size: 40px;
  font-weight: 900;
  text-align: left;
}

#page3b #body {
  font-size: 23px;
  font-weight: 500;
  text-align: left;
  line-height: 1.5;
}

#page3c {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
}

#page3c-search {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  max-width: 950px;
  min-width: 0;
  height: 70px;
  color: black;
  padding: 6px;
  background: white;
  border-radius: 7px;
  box-shadow: 0 6px 20px rgba(2, 6, 23, 0.6);
  border: 2px solid black;
  box-sizing: border-box;
} 

#page3c-search-input {
  border: 1px solid #ccc;
  background: white;
  color: black;
  font-size: 17px;
  font-weight: 600;
  outline: none;
  caret-color: gray;
  border-radius: 4px;
  padding: 8px 12px;
  width: 100%;
}

#page3c-search-input:focus {
  border-color: #00b4d8;
  box-shadow: 0 0 5px rgba(0, 180, 216, 0.5);
}

#search-btn2 {
  border: none;
  border-radius: 10px;
  color: black;
  background-color: #0a192f;
  width: 160px;
  padding-left: 5px;
  padding-right: 5px;
  color: white;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  font-weight: 600;
  height: 80%;
}

#page4 {
  width: 90%;
  /* height: 600px; */
  margin: 0 auto;
  /* overflow: hidden; */
  display: flex;
  padding: 90px 20px 0;
  /* gap: 100px; */
  /* background-color: #00b4d8; */
  align-items: center;
  /* border: 1px solid black; */
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
}



#page4a {
  display: flex;
  flex-direction: column;
  color: black;
  font-family: 'Poppins', sans-serif;
  justify-content: center;
}

#page4a-head {
  font-size: 30px;
  font-weight: 800;
}

#page4a-body {
  font-size: 16px;
  color: rgb(39, 39, 39);
}

#page4b {
  position: relative;
  width: 100%;
max-width: 900px; /* 3 slides * 300px */
  overflow: hidden;
  margin: 50px auto;
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items: center;

  margin-left: 40px;
  min-height: 300px;
}

#page4b-slides {
  display: flex;
  gap: 20px;
  transition: transform 0.5s ease-in-out;
  width:100%;
}

.slide {
  flex: 0 0 300px;
  height: 300px;
  width: 280px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  /* align-items: center; */
  /* background-color: brown; */
  border: 1px solid black;
}

#controls {
  text-align: center;
  margin-top : 50px;
  
}

#prev-btn, #next-btn {
  background: #00b4d8;
  color: white;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  margin: 0 10px;
  border-radius: 5px;
  font-weight: bold;
}

#prev-btn:hover, #next-btn:hover {
  background: #243b55;
}

/* Reuse your existing styles for inner divs */
#page4b-div1 {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 100%;
  gap: 50px;
  height: 70%;
  padding: 20px;
  background-color:rgb(248, 239, 222);

}

#page4b-slides a {
  text-decoration: none;
}

#page4b-div1a {
  display: flex;
  flex-direction: column;
  
}

#page4b-div1-head {
  font-size: 20px;
  font-weight: 800;
  color: black;
}

#page4b-div1-cat {
  font-size: 16px;
  color: black;
}

#page4b-div1b {
  display: flex;
  align-items: center;
}

#page4b-div1-all {
  font-size: 18px;
  color: black;
  font-weight: 500;
  display: flex;
  gap: 10px;
  text-align: center;
}


#page4b-div1b img {
  width: 30px;
  height: 30px;
  padding-bottom: 10px;
  object-fit: cover;
}

#page4b-div2 {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 100%;
  height: 30%;
  /* background-color: green; */
}

#page4b-div2 img{
  width: 100%;
  height: 100%;
padding: 5px;
  object-fit: cover;
}


#page5{
  background-color:rgb(248, 239, 222); ;
}

#faq-section {
   display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px;
    padding-top: 100px;
    font-family: Arial, sans-serif;
}

#faq-item-1, #faq-item-2, #faq-item-3 {
    margin-bottom: 10px;
    border:none;
    border-bottom: 4px solid black;
    border-radius: 5px;
}

#faq-question-1, #faq-question-2, #faq-question-3 {
    width: 100%;
    padding: 15px;
    background-color: #f7f7f7;
    border: none;
    text-align: left;
    font-size: 18px;
    cursor: pointer;
    position: relative;
}

#faq-question-1 > span, #faq-question-2 > span, #faq-question-3 > span {
    position: absolute;
    right: 15px;
    font-size: 24px;
    transition: transform 0.3s;
}

#faq-answer-1, #faq-answer-2, #faq-answer-3 {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, padding 0.3s ease-out;
    padding: 0 15px;
    background-color: #fff;
}

#faq-answer-1 p, #faq-answer-2 p, #faq-answer-3 p {
    margin: 15px 0;
}

/* Active state for expanded item */
#faq-item-1.active #faq-answer-1,
#faq-item-2.active #faq-answer-2,
#faq-item-3.active #faq-answer-3 {
    max-height: 500px; /* Adjust based on content length; or use 'none' for auto */
    padding: 15px;
}

#page6{
  display: flex;
  flex-direction: column;
  gap: 20px;
  color: white;
  background-color: rgb(19, 18, 18);
}

#page6-div{
  display: flex;
  align-items: center;
  justify-content:center;
  margin-top:30px ;
  margin-left: 30px;
  margin-right: 30px;
  width: 9 00px;
  height:1px;
  background-color:white;
}

#page6-all{
  display:flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
}

#page6a{
  display:flex;
  flex-direction: column;
  gap:10px;
  font-weight: 700;
}

#page6a #body{
  font-weight:100;
}

#page6b{
  font-weight: 700;
}

/* Language Dropdown */
#dropdown {
  position: relative;
  width: 100px;
  font-family: 'Poppins', sans-serif;
  user-select: none;
  background: #f4f7fa;
  border-radius: 12px;
  box-shadow: 0 6px 24px rgba(2, 6, 23, 0.12);
  transition: box-shadow 0.3s;
}

#dropdown.open,
#dropdown:focus-within,
#dropdown:hover {
  box-shadow: 0 8px 32px rgba(2, 6, 23, 0.18);
}

#dropdown-header {
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  background: #eaf2fb;
  font-size: 17px;
  font-weight: 500;
  color: #243b55;
  transition: background 0.3s;
}

#dropdown-header:hover {
  background: #dbeaf7;
}

#dropdown-arrow {
  font-size: 15px;
  margin-left: 8px;
  transition: transform 0.3s ease;
}

#dropdown.open #dropdown-arrow {
  transform: rotate(180deg);
}

#dropdown-list {
  display: none;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  min-width: 220px;
  width: auto;
  max-width: 90vw;
  background: #fff;
  border-radius: 7px;
  box-shadow: 0 4px 16px rgba(2, 6, 23, 0.10);
  z-index: 10;
  padding: 18px 20px 14px 20px;
  animation: fadeIn 0.3s;
  box-sizing: border-box;
}

#dropdown.open #dropdown-list,
#dropdown:focus-within #dropdown-list,
#dropdown:hover #dropdown-list {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

#lang-heading {
  font-size: 16px;
  font-weight: bold;
  color: #243b55;
  margin-bottom: 12px;
  text-align: left;
}

#language-form label {
  display: flex;
  align-items: center;
  margin: 8px 0;
  cursor: pointer;
  font-size: 15px;
  color: #243b55;
  padding-left: 2px;
  transition: background 0.2s;
  border-radius: 6px;
}

#language-form label:hover {
  background: #eaf2fb;
}

#language-form input[type="radio"] {
  margin-right: 10px;
  accent-color: #00b4d8;
  width: 18px;
  height: 18px;
}

.lang-flag {
  font-size: 20px;
  margin-right: 8px;
  vertical-align: middle;
  transition: transform 0.2s;
}

#language-form label:hover .lang-flag {
  transform: scale(1.2) rotate(-8deg);
}

#selected-language {
  font-weight: bold;
  color: #00b4d8;
  font-size: 16px;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 6px;
}

#earth-svg {
  display: flex;
  align-items: center;
}

#earth-svg-logo {
  width: 20px;
  height: 20px;
  margin-right: 4px;
}

/* Sign-in Dropdown */
#sign-in {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border-radius: 5px;
  padding: 0px 12px 0px 6px;
  color: black;
  font-size: 15px;
  font-weight: 500;
}

#page1b:hover #sign-in {
  background: #eaf2fb;
  cursor: pointer;
}

#sign-in-logo img {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  object-fit: cover;
}

#signin-dropdown-container {
  position: relative;
  display: inline-block;
}

#signin-dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 6px 24px rgba(2, 6, 23, 0.12);
  min-width: 220px;
  padding: 18px 22px 14px 22px;
  font-family: 'Poppins', sans-serif;
  flex-direction: column;
  align-items: flex-start;
  z-index: 200;
}

#signin-dropdown-container:hover #signin-dropdown,
#signin-dropdown-container:focus-within #signin-dropdown {
  display: flex;
}

#signin-header {
  font-size: 18px;
  font-weight: 600;
  color: #243b55;
  margin-bottom: 8px;
}

#signin-divider {
  width: 100%;
  height: 1.5px;
  background: linear-gradient(90deg, #00b4d8 0%, #243b55 100%);
  margin: 8px 0 12px 0;
  border-radius: 2px;
}

#signin-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
}

.signin-link {
  color: #00b4d8;
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
  transition: color 0.2s;
}

.signin-link:hover {
  color: #243b55;
  text-decoration: underline;
}

/* Download Button */
#Download button {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background-color: green;
  font-size: 13px;
  height: 40px;
  color: white;
  font-weight: 900;
  cursor: pointer;
  transition: background-color 0.2s;
  border-color: 3px red;
}

#Download a {
  border-color: 2px red;
}

#Download button:hover {
  background-color: darkgreen;
}

/* Course Dropdowns */
#course {
  position: relative;
  width: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-family: 'Poppins', sans-serif;
  background: #f4f7fa;
  border-radius: 12px;
  box-shadow: 0 6px 24px rgba(2, 6, 23, 0.12);
  transition: box-shadow 0.3s;
  padding: 16px 20px;
  cursor: pointer;
  font-size: 17px;
  color: #243b55;
}

#course.open,
#course:focus-within,
#course:hover {
  box-shadow: 0 8px 32px rgba(2, 6, 23, 0.18);
}

#course:hover {
  background: #dbeaf7;
}

#cdropdown-arrow {
  font-size: 15px;
  margin-left: 8px;
  transition: transform 0.3s ease;
}

#link-dropdown.open #dropdown-arrow {
  transform: rotate(180deg);
}

#link-dropdown {
  display: none;
  position: absolute;
  left: 50%;
  top: 110%;
  transform: translateX(-50%);
  background: #fff;
  border-radius: 7px;
  box-shadow: 0 4px 16px rgba(2, 6, 23, 0.10);
  padding: 18px 20px 14px 20px;
  animation: fadeIn 0.3s;
  width: 300%;
  z-index: 10;
}

#course.open #link-dropdown,
#course:focus-within #link-dropdown,
#course:hover #link-dropdown {
  display: block;
}

#link-header {
  font-size: 20px;
  font-weight: 900;
}

#link-divider {
  width: 100%;
  height: 1.5px;
  background: linear-gradient(90deg, #00b4d8 0%, #243b55 100%);
  margin: 8px 0 12px 0;
  border-radius: 2px;
}

#main-link {
  display: flex;
  gap: 40px;
  padding-bottom: 40px;
}

#main-link1,
#main-link2 {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#link {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

#link-head a {
  font-size: 16px;
  font-weight: 700;
  color: black;
  text-decoration: none;
  transition: color 0.2s;
}

#link-head a:hover {
  color: darkgreen;
}

#link-body a {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  gap: 7px;
  color: black;
  font-weight: 500;
  transition: color 0.2s;
}

#link-body a:hover {
  color: darkgreen;
}

/* Responsive adjustments */

/* About & Contact: Professional, responsive styling */
#about-contact{
  max-width:1100px;
  margin:60px auto;
  display:flex;
  gap:40px;
  padding:32px;
  background:#ffffff;
  border-radius:12px;
  box-shadow:0 6px 30px rgba(2,6,23,0.06);
  font-family: 'Poppins', sans-serif;
  color:#243b55;
}

#about-us, #contact-us{
  flex:1;
}

#about-us h2, #contact-us h2{
  font-size:24px;
  margin-bottom:12px;
  color:#0a192f;
}

#about-us p{ font-size:16px; line-height:1.6; color:#334155; margin-bottom:12px; }
.about-list{ list-style:none; padding-left:18px; margin-top:8px; }
.about-list li{ margin-bottom:8px; padding-left:18px; position:relative; }
.about-list li::before{ content:'•'; color:#00b4d8; position:absolute; left:0; top:0; font-weight:700; }

.contact-cards{ display:flex; gap:12px; margin-bottom:16px; flex-wrap:wrap; }
.contact-card{ flex:1; min-width:160px; background:#f7fafc; padding:12px; border-radius:8px; border:1px solid #e6eef6; }
.contact-card h3{ margin-bottom:6px; color:#0a192f; }
.contact-card p,a{ font-size:14px; color:#334155; text-decoration:none; }

#contact-form{ display:flex; gap:12px; flex-direction:column; margin-top:8px; }
#contact-form input, #contact-form textarea{ padding:10px; border:1px solid #d1e9f6; border-radius:6px; font-size:14px; }
#contact-form textarea{ min-height:120px; resize:vertical; }

.btn-primary{ background:#00b4d8; color:white; border:none; padding:10px 14px; border-radius:6px; font-weight:700; cursor:pointer; }
.btn-primary:hover{ background:#0a7fa1; }

/* Responsive utilities and mobile navigation */
:root{
  --max-width:1100px;
  --accent: #00b4d8;
  --muted: #334155;
  --bg: #ffffff;
}

.container{ max-width:var(--max-width); margin:0 auto; padding:0 16px; }

/* Header adjustments */
#page1{ padding: 10px 16px; justify-content:space-between; }
#page1a{ gap:12px; }
#page1a-name{ font-size:18px; }
#page1a-name img{ width:40px; height:40px; }

#mobile-menu-btn{ display:none; background:transparent; border:none; font-size:24px; padding:8px; cursor:pointer; color:#243b55; border-radius:6px; }
#mobile-menu-btn:focus{ outline:2px solid rgba(0,180,216,0.3); }

/* Make the navigation (#page2) transform into a mobile panel */
#page2{ transition:transform 0.3s ease, opacity 0.3s ease; }

/* Mobile nav off-canvas */
body.mobile-nav-open #page2{
  position:fixed; top:64px; left:0; right:0; background:var(--bg); z-index:400; padding:18px 20px; box-shadow:0 8px 30px rgba(2,6,23,0.12); transform:translateY(0); opacity:1; }

/* Hidden by default on small screens */




/* Ensure buttons and form controls expand on small screens */
#Download button, .btn-primary{ width:auto; min-width:120px; }
#contact-form input, #contact-form textarea{ width:100%; box-sizing:border-box; }

/* Add smooth image and layout responsiveness */
img{ max-width:100%; height:auto; display:block; }

/* Accessibility: make dropdowns full-width in mobile nav */


/* small tweak for page4 slideshow on narrow screens */
 

/* Messages and form error styles */
.messages-wrapper{ max-width:1100px; margin:20px auto; padding:10px 16px; }
.message{ padding:12px 16px; border-radius:8px; margin-bottom:8px; font-weight:600; }
.message.success{ background: linear-gradient(90deg,#dff6fb,#e6fbff); color:#0a7fa1; border:1px solid #bfeff8; }
.message.error{ background:#fff1f0; color:#9b2c2c; border:1px solid #f5c6cb; }

.form-errors{ background:#fff6e6; border:1px solid #fde4b9; padding:10px; border-radius:8px; margin-bottom:12px; }
.form-errors .error{ color:#7a391f; font-weight:600; margin-bottom:6px; }

/* ---------------------------
   Global utilities & layout
   --------------------------- */
:root {
  --max-width:1100px;
  --gap: 20px;
  --accent: #00b4d8;
  --muted: #334155;
  --bg: #ffffff;
}

.container { max-width: var(--max-width); margin: 0 auto; padding: 0 16px; }
.row { display:flex; gap:var(--gap); flex-wrap:wrap; }
.col { flex:1; min-width:250px; }
.text-center { text-align:center; }
.mt-12 { margin-top:12px; }
.mb-12 { margin-bottom:12px; }

/* Overlay (used for mobile nav / modals) */
.page-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:380; display:none; opacity:0; transition:opacity 0.2s ease;
}
.page-overlay.open{ display:block; opacity:1; }

/* Drawer styles for mobile nav */
.mobile-drawer {
  position: fixed; top: 64px; left: 0; right: 0; background: var(--bg); z-index: 390; padding: 20px; box-shadow: 0 8px 30px rgba(2,6,23,0.12); border-top-left-radius:12px; border-top-right-radius:12px; transform: translateY(-10px); opacity:0; transition: transform 0.2s ease, opacity 0.2s ease;
}
.mobile-drawer.open{ transform: translateY(0); opacity:1; }

/* Focus states */
:focus { outline: 2px solid rgba(0,180,216,0.18); outline-offset: 2px; }
button, a[role='button'] { cursor:pointer; }

/* Small improvements to hero and slideshow */
#page3 a, #page3b, #page3a { max-width:100%; }
#page3a { height:auto; }
#page3a #slides { height: 240px; }
#page3a #slide { background-size: cover; background-position:center; }

/* Ensure footer stacks cleanly */
#page6-all { flex-direction: column; gap: 8px; align-items: flex-start; }


/* Final responsive polish */
  .container{ padding: 0 12px; }


